# Copy to .env (which is gitignored) and change the values.
# .env is loaded automatically (app/env_file.py) — nothing needs sourcing it
# into your shell first; a real exported env var still overrides it.
CMS_SECRET_KEY=change-me-to-a-long-random-string
CMS_SITE_TITLE=Knox County Historical Society
CMS_DATABASE=cms.db
# Demo accounts created by scripts/seed_demo.py
CMS_ADMIN_PASSWORD=change-me-admin
CMS_EDITOR_PASSWORD=change-me-editor
CMS_DEACTIVATED_PASSWORD=change-me-deactivated
# Set after you deploy, e.g. https://yourname.github.io/iphs400-mp2-cms/
CMS_BASE_PATH=
# Your name, used in docs/transcripts/ filenames by the SessionEnd hook.
CMS_STUDENT=adam-leider
